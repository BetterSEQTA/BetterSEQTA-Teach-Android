# Copy to secrets.properties (gitignored) or add these keys to local.properties.
# Cloudflare Workers AI — same values as iOS CloudflareSecrets.plist / .env.

CF_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CF_AUTH_TOKEN=YOUR_CLOUDFLARE_AUTH_TOKEN

# Optional legacy API key (not used when CF_AUTH_TOKEN is set)
CLOUDFLARE_API_KEY=YOUR_API_KEY
